    <addon id="plugin.video.Iskierek-IPTV-Full" name="[COLOR yellow]Iskierek[/COLOR] [COLOR aqua]IPTV[/COLOR] [COLOR red]FULL[/COLOR]" version="2026.05.15.1" provider-name="Iskierek">
        <requires>
            <import addon="xbmc.python" version="3.0.0" />
            <import addon="script.module.six" />
        </requires>
        <extension point="xbmc.python.pluginsource" library="default.py">
            <provides>video</provides>
        </extension>
        <extension point="xbmc.service" library="service.py" start="startup" />
        <extension point="xbmc.addon.metadata">
            <summary lang="pl">Rozbudowany kombajn IPTV: Stalker, Xtream, M3U, VOD, eksport M3U i Polska TV PRO.</summary>
            <description lang="pl">
      Iskierek IPTV Full to kompleksowa wtyczka IPTV dla Kodi obsługująca:
      - Stalker / MAC
      - Xtream Codes
      - M3U (URL i plik lokalny)

      Funkcje:
      - Inteligentne sortowanie polskich kanałów
      - Własne grupy i poprawianie nazw kanałów
      - Ukrywanie kanałów i personalizacja list
      - Obsługa VOD i seriali (z możliwością pobierania)
      - Eksport M3U (pełna lista lub pojedyncze grupy)
      - Kontrola rodzicielska z PIN
      - Obsługa proxy / f4mTester
      - Zewnętrzne EPG XMLTV z buforowaniem

      Wtyczka zaprojektowana jako rozbudowany system IPTV typu "All-in-One".
    </description>
            <summary lang="en">Advanced All-in-One IPTV addon: Stalker, Xtream, M3U, VOD and Smart Polish TV sorting.</summary>
            <description lang="en">
      Iskierek IPTV Full is a powerful all-in-one IPTV addon for Kodi supporting:
      - Stalker / MAC portals
      - Xtream Codes
      - M3U playlists (URL and local file)

      Features:
      - Smart Polish channel sorting engine
      - Custom groups and channel renaming
      - Channel hiding and personalization
      - VOD and Series support with download option
      - M3U export (full list or single groups)
      - Parental control with PIN protection
      - Proxy / f4mTester support
      - External XMLTV EPG with caching
    </description>
            <assets>
                <icon>icon.png</icon>
                <fanart>fanart.jpg</fanart>
                <screenshot>resources/media/listadostawców.jpg</screenshot>
                <screenshot>resources/media/menu.jpg</screenshot>
                <screenshot>resources/media/grupy.jpg</screenshot>
                <screenshot>resources/media/kanały.jpg</screenshot>
                <screenshot>resources/media/przewodnik.jpg</screenshot>
            </assets>
            <news>
      [B]Wersja 1.0.0.0[/B]
      - Obsługa Stalker / MAC
      - Obsługa Xtream Codes
      - Obsługa M3U (URL i plik lokalny)
      - Inteligentne sortowanie Polskiej TV
      - Eksport M3U (pełna lista i grupy)
      - VOD i seriale z możliwością pobierania
      - Kontrola rodzicielska (PIN)
      - Obsługa zewnętrznego EPG XMLTV
    </news>
            <platform>all</platform>
        </extension>
    </addon>
